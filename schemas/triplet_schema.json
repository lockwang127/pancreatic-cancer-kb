{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "知识三元组Schema",
  "description": "胰腺癌知识库知识三元组标准格式",
  "type": "object",
  "required": ["head", "relation", "tail"],
  "properties": {
    "head": {
      "type": "string",
      "description": "实体头节点/主语"
    },
    "relation": {
      "type": "string",
      "description": "关系类型",
      "enum": [
        "是",
        "有",
        "位于",
        "用于",
        "推荐",
        "禁忌",
        "导致",
        "相关",
        "包括",
        "分期为",
        "治疗方案为",
        "指标为",
        "发生于",
        "通过",
        "剂量为",
        "频率为"
      ]
    },
    "tail": {
      "type": "string",
      "description": "实体尾节点/宾语"
    },
    "source": {
      "type": "string",
      "description": "证据来源类型",
      "enum": ["指南", "文献", "临床试验", "专家共识", "数据库"]
    },
    "evidence": {
      "type": "string",
      "description": "具体证据描述"
    },
    "domain": {
      "type": "string",
      "description": "知识领域",
      "enum": ["流行病学", "诊断", "分期", "治疗", "预后", "生物标志物", "病理"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "置信度 0-1"
    },
    "pmid": {
      "type": "string",
      "description": "PubMed ID (可选)"
    }
  }
}
